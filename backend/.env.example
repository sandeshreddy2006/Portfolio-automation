# Local SQLite. Railway uses the PostgreSQL service reference below.
DATABASE_URL=sqlite:///./portfolio.db
FRONTEND_URL=http://localhost:3000

# On Railway, set these on the FastAPI service:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# FRONTEND_URL=https://www.portfolabs.com
# Separate multiple allowed frontend origins with commas.

# Google OAuth Web application credentials.
# Register the first FRONTEND_URL origin plus /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate a random secret, for example with openssl rand -hex 32.
AUTH_CODE_SECRET=

# Gmail SMTP on Railway Pro. Use your Gmail address and a Google app password.
# The defaults are smtp.gmail.com, STARTTLS port 587, and Portfolabs as the sender name.
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# MAIL_FROM="Portfolabs <your-address@gmail.com>"

# Optional HTTPS alternative. Set MAIL_FROM to a verified sender when using Resend.
# RESEND_API_KEY=

# ---- Image uploads: Cloudflare R2 (leave unset locally; images then go to backend/uploads) ----
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=portfolabs-media
# Keep the bucket private. Portfolabs serves authorized images through /media.

# ---- Writing assistant (the "Improve with AI" buttons), powered by Google Gemini. ----
# Free key: https://aistudio.google.com/apikey  (leave unset to hide the buttons)
# GEMINI_API_KEY=
# Defaults to gemini-flash-latest (Google's alias for its current fast model).
# AI_MODEL=
# Overall cap on assistant calls per day across the whole site; keeps you inside the free quota.
# AI_DAILY_LIMIT=400

# ---- Moderation ----
# Where reports are emailed. Optional.
# REPORT_EMAIL=
# Must match REVALIDATE_SECRET on the website (16+ random characters). Used by moderate.py.
# REVALIDATE_SECRET=
