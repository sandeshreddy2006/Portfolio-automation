# Local FastAPI URL. The Next.js server also uses this for the auth routes.
# On Vercel, use the Railway API's public HTTPS URL.
BACKEND_URL=http://127.0.0.1:8000

# Public address of the site (used for share previews, canonical links and the sitemap).
# NEXT_PUBLIC_SITE_URL=https://www.portfolabs.com
# Contact address shown on the Terms and Privacy pages.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@portfolabs.com

# Subdomains (name.portfolabs.com). Needs wildcard DNS first; leave unset until then.
# ROOT_DOMAIN=portfolabs.com
# NEXT_PUBLIC_ROOT_DOMAIN=portfolabs.com

# Lets backend/moderate.py clear a taken-down page from the cache (16+ random characters).
# REVALIDATE_SECRET=
